<?php
// Receiver of the 「それとなく聞く」アンケート and of the 診断ドック counters (generated by sites/yorokobu/askserver.py from ask_receiver.php.tpl; do not edit the generated file by hand).
// Everything lives in <site folder>/ask/ (outside the web root):
//   s/<id>.json    one survey: the hash of its secret key, its mode (o = open, s = secret), the day it was made, how many answers it has
//   s/<id>.jsonl   its answers, one line each: the time and the chosen options (ids of options; there is no free text, no name, no address)
//   push/<h>.json  a notification subscription of the person who made surveys: the browser's endpoint and keys, and {survey id, answers already announced}
//   stats/<ym>.json  counters only: how often an option was chosen (no link to a person or a survey)
// A GitHub workflow reads push/ and the survey counts over SSH and sends one content-free message per subscription that has new answers.
date_default_timezone_set('Asia/Tokyo');
header('X-Robots-Tag: noindex');
header('Cache-Control: no-store');
header('Content-Type: application/json; charset=UTF-8');
function out($code, $data = null) {
    http_response_code($code);
    if ($data !== null) { echo json_encode($data, JSON_UNESCAPED_UNICODE); }
    exit;
}
if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') { out(405); }
$origin = (string)($_SERVER['HTTP_ORIGIN'] ?? '');
if ($origin !== '' && $origin !== '__SITE_URL__') { out(403); }                       // the pages of this site only
$raw = file_get_contents('php://input', false, null, 0, 16385);
if ($raw === false || strlen($raw) > 16384) { out(413); }
$d = json_decode($raw, true);
if (!is_array($d) || ($d['v'] ?? 0) !== 1 || !is_string($d['op'] ?? null)) { out(400); }
$op = $d['op'];
// The questions and options this site really has: {"q1": {"max": 3, "o": ["home", "cafe", ...]}, ...} (made from content/ask.json when the site is built).
$ASK = json_decode('__ASK__', true);
$site = dirname(__DIR__, 2);                                                         // public_html/api/ask.php -> <site folder>
$dir = $site . '/ask';
foreach (array($dir, $dir . '/s', $dir . '/push', $dir . '/stats') as $p) {
    if (!is_dir($p) && !@mkdir($p, 0700, true)) { out(503); }
}

// A limit on requests per sender, per kind of request and day: a salted daily hash of the address in a counter file (the address itself is never stored).
function limit($dir, $group, $max) {
    $ip = (string)($_SERVER['REMOTE_ADDR'] ?? '');
    $who = substr(hash('sha256', $ip . '|' . date('Y-m-d') . '|' . basename(dirname($dir)) . '|ask'), 0, 16);
    $h = @fopen($dir . '/rate-' . date('Ymd') . '-' . $group . '-' . $who, 'c+');       // read, judge and write under one lock: parallel requests cannot all see the old count
    if (!$h) { return; }
    $over = false;
    if (flock($h, LOCK_EX)) {
        $n = (int)stream_get_contents($h);
        if ($n >= $max) { $over = true; } else { ftruncate($h, 0); rewind($h); fwrite($h, (string)($n + 1)); fflush($h); }
        flock($h, LOCK_UN);
    }
    fclose($h);
    if ($over) { out(429); }
}
foreach ((glob($dir . '/rate-*') ?: array()) as $f) { if (strpos($f, '/rate-' . date('Ymd') . '-') === false) { @unlink($f); } }

function idok($s) { return is_string($s) && preg_match('/^[A-Za-z0-9_-]{22}$/', $s) === 1; }
function write_json($file, $data) {
    $json = json_encode($data);
    if ($json === false) { return false; }
    $tmp = $file . '.tmp';
    if (@file_put_contents($tmp, $json, LOCK_EX) === false || !@rename($tmp, $file)) { @unlink($tmp); return false; }
    @chmod($file, 0600);
    return true;
}
function read_json($file) {
    $r = is_file($file) ? json_decode((string)@file_get_contents($file), true) : null;
    return is_array($r) ? $r : null;
}
// Counters: {"key": count} per month; keys are short lowercase words with dots; at most 6000 different keys.
function bump($dir, $keys) {
    $f = $dir . '/stats/' . date('Y-m') . '.json';
    $h = @fopen($f, 'c+');
    if (!$h) { return; }
    if (flock($h, LOCK_EX)) {
        $cur = json_decode((string)stream_get_contents($h), true);
        if (!is_array($cur)) { $cur = array(); }
        foreach ($keys as $k) {
            if (isset($cur[$k])) { $cur[$k] = (int)$cur[$k] + 1; } elseif (count($cur) < 6000) { $cur[$k] = 1; }
        }
        ftruncate($h, 0); rewind($h); fwrite($h, json_encode($cur)); fflush($h); flock($h, LOCK_UN);
    }
    fclose($h);
}
function survey($dir, $id) {
    if (!idok($id)) { return null; }
    return read_json($dir . '/s/' . $id . '.json');
}
function owns($meta, $key) { return $meta !== null && idok($key) && isset($meta['kh']) && hash_equals((string)$meta['kh'], hash('sha256', $key)); }

if ($op === 'new') {                                                                  // a person makes a survey: its id (public, in the link) and secret key (kept on the person's device)
    limit($dir, 'new', 20);
    $id = $d['id'] ?? ''; $key = $d['key'] ?? '';
    if (!idok($id) || !idok($key)) { out(400); }
    $mode = ($d['mode'] ?? '') === 's' ? 's' : 'o';
    if (is_file($dir . '/s/' . $id . '.json')) { out(409); }
    if (count(glob($dir . '/s/*.json') ?: array()) >= 20000) { out(503); }
    $rec = array('v' => 1, 'kh' => hash('sha256', $key), 'm' => $mode, 'c' => date('Y-m-d'), 'n' => 0);
    if (!write_json($dir . '/s/' . $id . '.json', $rec)) { out(503); }
    if (mt_rand(1, 40) === 1) {                                                       // now and then: surveys made more than 120 days ago are removed with their answers (a few hundred checked each time)
        $cut = date('Y-m-d', time() - 120 * 86400);
        $files = glob($dir . '/s/*.json') ?: array();
        shuffle($files);
        foreach (array_slice($files, 0, 300) as $f) {
            $m = read_json($f);
            if (is_array($m) && isset($m['c']) && is_string($m['c']) && $m['c'] < $cut) { @unlink($f); @unlink(substr($f, 0, -5) . '.jsonl'); }
        }
        foreach ((glob($dir . '/push/*.json') ?: array()) as $f) { if (@filemtime($f) !== false && filemtime($f) < time() - 120 * 86400) { @unlink($f); } }
    }
    bump($dir, array('ask.new.' . $mode));
    out(204);
}

if ($op === 'answer') {                                                               // a person answers: option ids only, of questions and options this site has
    limit($dir, 'ans', 60);
    $id = $d['id'] ?? '';
    $meta = survey($dir, $id);
    if ($meta === null) { out(404); }
    $a = $d['a'] ?? null;
    if (!is_array($a) || count($a) > 12 || !is_array($ASK)) { out(400); }
    $clean = array();
    foreach ($a as $q => $v) {
        if (!is_string($q) || !isset($ASK[$q])) { out(400); }                          // an unknown question: the whole answer is refused
        $vals = is_array($v) ? $v : array($v);
        $c = array();
        foreach ($vals as $x) {
            if (!is_string($x) || !in_array($x, $ASK[$q]['o'], true)) { out(400); }    // an unknown option: the same
            $c[$x] = true;
        }
        if (count($c) < 1 || count($c) > (int)$ASK[$q]['max']) { out(400); }
        $clean[$q] = array_keys($c);
    }
    if (!$clean) { out(400); }
    $line = json_encode(array('t' => date('c'), 'a' => $clean), JSON_UNESCAPED_UNICODE);
    if ($line === false) { out(400); }
    $h = @fopen($dir . '/s/' . $id . '.json', 'c+');                                  // the limit, the answer and the count under ONE lock on the survey's file
    if (!$h) { out(503); }
    $code = 503;
    if (flock($h, LOCK_EX)) {
        $m = json_decode((string)stream_get_contents($h), true);
        if (!is_array($m)) { $code = 404; }
        elseif ((int)($m['n'] ?? 0) >= 40) { $code = 429; }                            // a survey takes at most 40 answers
        elseif (@file_put_contents($dir . '/s/' . $id . '.jsonl', $line . "\n", FILE_APPEND | LOCK_EX) === false) { $code = 503; }
        else {
            $m['n'] = (int)($m['n'] ?? 0) + 1;
            ftruncate($h, 0); rewind($h); fwrite($h, json_encode($m)); fflush($h);
            $code = 204;
        }
        flock($h, LOCK_UN);
    }
    fclose($h);
    if ($code !== 204) { out($code); }
    $keys = array('ask.n.all', 'ask.mode.' . (($meta['m'] ?? 'o') === 's' ? 's' : 'o'));
    foreach ($clean as $q => $opts) { foreach ($opts as $o) { $keys[] = 'ask.' . $q . '.' . $o; } }
    bump($dir, $keys);
    out(204);
}

if ($op === 'read') {                                                                 // the person who made the survey reads its answers (with the secret key)
    limit($dir, 'read', 600);
    $id = $d['id'] ?? '';
    $meta = survey($dir, $id);
    if (!owns($meta, $d['key'] ?? '')) { out(403); }
    $rows = array();
    $f = $dir . '/s/' . $id . '.jsonl';
    foreach ((is_file($f) ? (file($f, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) ?: array()) : array()) as $l) {
        $r = json_decode($l, true);
        if (is_array($r) && isset($r['a']) && is_array($r['a'])) { $rows[] = array('t' => (string)($r['t'] ?? ''), 'a' => $r['a']); }
        if (count($rows) >= 40) { break; }
    }
    out(200, array('m' => ($meta['m'] ?? 'o'), 'n' => (int)($meta['n'] ?? 0), 'c' => (string)($meta['c'] ?? ''), 'r' => $rows));
}

if ($op === 'del') {                                                                  // the person deletes the survey and its answers
    limit($dir, 'del', 60);
    $id = $d['id'] ?? '';
    if (!owns(survey($dir, $id), $d['key'] ?? '')) { out(403); }
    @unlink($dir . '/s/' . $id . '.json');
    @unlink($dir . '/s/' . $id . '.jsonl');
    foreach ((glob($dir . '/push/*.json') ?: array()) as $f) {                        // and the survey leaves every notification subscription; a subscription that watches nothing is deleted
        $p = read_json($f);
        if (!is_array($p) || !is_array($p['watch'] ?? null)) { continue; }
        $keep = array();
        foreach ($p['watch'] as $w) { if (is_array($w) && ($w['id'] ?? '') !== $id) { $keep[] = $w; } }
        if (count($keep) === count($p['watch'])) { continue; }
        if (!$keep) { @unlink($f); } else { $p['watch'] = $keep; write_json($f, $p); }
    }
    out(204);
}

if ($op === 'sub') {                                                                  // notifications: this browser wants to hear when one of the surveys it made gets a new answer
    limit($dir, 'sub', 40);
    $endpoint = is_array($d['sub'] ?? null) ? ($d['sub']['endpoint'] ?? '') : ($d['endpoint'] ?? '');
    if (!is_string($endpoint) || strlen($endpoint) > 1024 || !preg_match('#^https://[A-Za-z0-9.-]+(:\d+)?/[^\s"<>]*$#', $endpoint)) { out(400); }
    // Only the push services of the browsers (Chrome/Android, Firefox, Safari/iOS, Edge): the sender would otherwise POST to any address a visitor names.
    if (!preg_match('#^https://([A-Za-z0-9-]+\.)*(googleapis\.com|push\.services\.mozilla\.com|mozaws\.net|push\.apple\.com|notify\.windows\.com)(:\d+)?/#', $endpoint)) { out(400); }
    $file = $dir . '/push/' . hash('sha256', $endpoint) . '.json';
    if (!empty($d['off'])) { @unlink($file); out(204); }
    $keys = is_array($d['sub']['keys'] ?? null) ? $d['sub']['keys'] : null;
    $b64 = '#^[A-Za-z0-9_-]{10,200}$#';
    if (!$keys || !is_string($keys['p256dh'] ?? null) || !is_string($keys['auth'] ?? null) || !preg_match($b64, $keys['p256dh']) || !preg_match($b64, $keys['auth'])) { out(400); }
    $old = array();
    $prev = read_json($file);
    foreach ((is_array($prev) && is_array($prev['watch'] ?? null)) ? $prev['watch'] : array() as $o) {
        if (is_array($o) && idok($o['id'] ?? null)) { $old[$o['id']] = (int)($o['sent'] ?? 0); }
    }
    $watch = array(); $n = 0;
    foreach ((is_array($d['watch'] ?? null) ? $d['watch'] : array()) as $x) {
        if (++$n > 30) { break; }
        if (!is_array($x) || !idok($x['id'] ?? null)) { continue; }
        $meta = survey($dir, $x['id']);
        if (!owns($meta, $x['key'] ?? '')) { continue; }                              // only the surveys the sender made
        $watch[$x['id']] = array('id' => $x['id'], 'sent' => isset($old[$x['id']]) ? $old[$x['id']] : (int)($meta['n'] ?? 0));   // a new one starts from the answers it has now
    }
    if (!$watch) { @unlink($file); out(204); }                                         // nothing of the sender's to watch: nothing is kept
    if (!is_file($file) && count(glob($dir . '/push/*.json') ?: array()) >= 3000) { out(503); }
    $rec = array('endpoint' => $endpoint, 'keys' => array('p256dh' => $keys['p256dh'], 'auth' => $keys['auth']), 'watch' => array_values($watch), 'updated' => date('c'));
    if (!write_json($file, $rec)) { out(503); }
    out(204);
}

if ($op === 'stat') {                                                                 // counters: how often an option of the 診断ドック was chosen, and how often a product's shop button was pressed (pop.r.<rakuten item code> / pop.a.<ASIN>), and what kinds of question the 贈り物コンシェルジュ is asked (cq.<kind>.<value>; nothing else)
    limit($dir, 'stat', 80);
    $ks = is_array($d['k'] ?? null) ? $d['k'] : array();
    $keys = array();
    foreach ($ks as $k) {
        if (count($keys) >= 40) { break; }
        if (is_string($k) && preg_match('/^(dock\.[a-z0-9]{1,8}\.[a-z0-9_-]{1,32}|pop\.[ra]\.[A-Za-z0-9._:-]{3,64}|cq\.[a-z]{1,6}\.[a-z0-9_-]{1,32})$/', $k) === 1) { $keys[$k] = true; }
    }
    if (!$keys) { out(400); }
    bump($dir, array_keys($keys));
    out(204);
}

if ($op === 'voice') {                                                                // the concierge: a sentence the visitor chose to send (80 characters at most; read by the operator through the encrypted inbox)
    limit($dir, 'voice', 12);
    $kind = $d['k'] ?? ''; $t = $d['t'] ?? '';
    if (!is_string($kind) || !in_array($kind, array('miss', 'why', 'need', 'other'), true) || !is_string($t)) { out(400); }
    $t = trim((string)preg_replace('/\s+/u', ' ', $t));
    $n = function_exists('mb_strlen') ? mb_strlen($t, 'UTF-8') : strlen($t);
    if ($n < 2 || $n > 80) { out(400); }
    if (preg_match('/[0-9０-９]{7,}|@|＠|https?:|www\.|〒|[0-9]{3}-[0-9]{4}/u', $t) === 1) { out(422); }       // a phone number, an address, a mail address or a link: refused, not stored
    $vd = $dir . '/voice';
    if (!is_dir($vd) && !@mkdir($vd, 0700, true)) { out(503); }
    $f = $vd . '/v-' . date('Ym') . '.jsonl';
    if (is_file($f) && filesize($f) > 1048576) { out(503); }                          // a month's file stays small
    $line = json_encode(array('id' => bin2hex(random_bytes(6)), 'at' => date('c'), 'site' => 'yorokobu', 'kind' => $kind, 'message' => $t), JSON_UNESCAPED_UNICODE);
    if ($line === false || @file_put_contents($f, $line . "\n", FILE_APPEND | LOCK_EX) === false) { out(503); }
    @chmod($f, 0600);
    bump($dir, array('cq.voice.' . $kind));
    out(204);
}

out(400);
