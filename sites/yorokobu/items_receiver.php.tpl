<?php
// The products behind 気になるリスト, 共有リスト, おまかせガチャ and the product tips of the answer pages (generated by sites/yorokobu/itemsserver.py from items_receiver.php.tpl; do not edit the copy on the server).
// The shops' data (names, prices, picture and shop links) is NOT a public file: the deploy puts it in the private folder ~/yorokobu-private/ (outside the web root), and this script gives out
// only what a page needs for its own purpose, a few products at a time:
//   ?c=<code>,<code>,...        up to 24 products by their code           -> {"<code>": {"n","p","i","u"}, ...}   (only the codes found)
//   ?r=<recipient>&t=<tier>[&x=<link of the last one>]    one product at random for the gacha   -> {"row": [name, price, image, link, reviews, rating x10]} or {"row": null}
//   ?pk=<pair key>&t=<tier>[&n=3&k=<kind no.>&exc=<kind nos.>&x=<links shown last>]   up to 3 products of different ideas for a pair (occasion x recipient) -> {"rows": [[idea no., kind no., line, price, picture, link, reviews, rating x10], ...]}
//   ?g=<group>[&min=&max=&gender=&n=]   up to 12 products of an interest group that fit the budget  -> {"items": [...]}
// Same-site requests only, and a daily limit per sender.
date_default_timezone_set('Asia/Tokyo');
header('X-Robots-Tag: noindex');
header('Cache-Control: no-store');
header('Content-Type: application/json; charset=UTF-8');
function out($code, $data = null) {
    http_response_code($code);
    if ($data !== null) { echo json_encode($data, JSON_UNESCAPED_UNICODE); }
    exit;
}
if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'GET') { out(405); }
$fs = (string)($_SERVER['HTTP_SEC_FETCH_SITE'] ?? '');
if ($fs !== '' && $fs !== 'same-origin') { out(403); }                                 // a browser that says the request comes from elsewhere
$ref = (string)($_SERVER['HTTP_REFERER'] ?? '');
if ($ref !== '' && strpos($ref, '__SITE_URL__/') !== 0) { out(403); }                  // the pages of this site only
$home = dirname(__DIR__, 3);                                                           // public_html/api/items.php -> the home of the server account
$priv = $home . '/yorokobu-private';
$work = $priv . '/api-limits';
if (!is_dir($work) && !@mkdir($work, 0700, true)) { out(503); }

// A daily limit per sender (a salted daily hash of the address in a counter file; the address itself is never stored).
$ip = (string)($_SERVER['REMOTE_ADDR'] ?? '');
$who = substr(hash('sha256', $ip . '|' . date('Y-m-d') . '|items'), 0, 16);
foreach ((glob($work . '/rate-*') ?: array()) as $f) { if (strpos($f, '/rate-' . date('Ymd') . '-') === false) { @unlink($f); } }
$h = @fopen($work . '/rate-' . date('Ymd') . '-' . $who, 'c+');
if ($h) {
    $over = false;
    if (flock($h, LOCK_EX)) {
        $n = (int)stream_get_contents($h);
        if ($n >= __LIMIT__) { $over = true; } else { ftruncate($h, 0); rewind($h); fwrite($h, (string)($n + 1)); fflush($h); }
        flock($h, LOCK_UN);
    }
    fclose($h);
    if ($over) { out(429); }
}

function load_db($file) {
    $raw = @file_get_contents($file);
    if ($raw === false) { out(503); }
    $d = json_decode($raw, true);
    if (!is_array($d)) { out(503); }
    return $d;
}
function slug($s) { return is_string($s) && preg_match('/^[a-z0-9_-]{1,40}$/', $s) === 1; }
function yen_or_null($v) { return (is_string($v) && preg_match('/^\d{1,9}$/', $v) === 1) ? (int)$v : null; }

if (isset($_GET['c'])) {
    $codes = array_slice(array_filter(explode(',', (string)$_GET['c']), function ($c) { return preg_match('/^[A-Za-z0-9._:-]{1,64}$/', $c) === 1; }), 0, 24);
    $db = load_db($priv . '/yorokobu_items_db.json');
    $res = array();
    foreach ($codes as $c) { if (isset($db[$c])) { $res[$c] = $db[$c]; } }
    out(200, (object)$res);
}
if (isset($_GET['pk'], $_GET['t'])) {
    $pk = $_GET['pk']; $t = $_GET['t'];
    if (!slug($pk) || !slug($t)) { out(400); }
    $n = max(1, min(3, (int)($_GET['n'] ?? 3)));
    $take = yen_or_null($_GET['k'] ?? null);
    $exc = array();
    foreach (explode(',', (string)($_GET['exc'] ?? '')) as $e) { if (preg_match('/^\d{1,2}$/', $e) === 1) { $exc[] = (int)$e; } }
    $shown = array();
    foreach (explode(',', (string)($_GET['x'] ?? '')) as $x) { if ($x !== '' && strlen($x) <= 400) { $shown[] = $x; } }
    $db = load_db($priv . '/yorokobu_gacha_db.json');
    $tiers = isset($db['pair'][$pk]['tiers']) && is_array($db['pair'][$pk]['tiers']) ? $db['pair'][$pk]['tiers'] : array();
    $order = array();
    foreach ((isset($db['order']) && is_array($db['order']) ? $db['order'] : array()) as $o) { if (is_string($o)) { $order[] = $o; } }
    $pos = array_search($t, $order, true);
    $try = array($t);
    if ($pos !== false) {
        $dist = array();
        foreach ($order as $k => $o) { if ($o !== $t && isset($tiers[$o]) && abs($k - $pos) <= 2) { $dist[$o] = abs($k - $pos) * 100 + $k; } }
        asort($dist);
        $try = array_merge($try, array_keys($dist));
    }
    $res = array(); $bands = array(); $used = array();
    foreach ($try as $tt) {
        if (count($res) >= $n) { break; }
        $by = array();
        foreach ((isset($tiers[$tt]) && is_array($tiers[$tt]) ? $tiers[$tt] : array()) as $r) {
            if (in_array($r[1], $exc, true) || ($take !== null && $r[1] !== $take) || isset($used[$r[0]])) { continue; }
            $by[$r[0]][] = $r;
        }
        $ideas = array_keys($by);
        shuffle($ideas);
        foreach ($ideas as $i) {
            $fresh = array();
            foreach ($by[$i] as $r) { if (!in_array($r[5], $shown, true)) { $fresh[] = $r; } }
            if (!count($fresh)) { $fresh = $by[$i]; }
            $res[] = $fresh[random_int(0, count($fresh) - 1)];
            $bands[] = $tt;
            $used[$i] = true;
            if (count($res) >= $n) { break; }
        }
    }
    out(200, array('rows' => $res, 'bands' => $bands));
}
if (isset($_GET['r'], $_GET['t'])) {
    $r = $_GET['r']; $t = $_GET['t'];
    if (!slug($r) || !slug($t)) { out(400); }
    $db = load_db($priv . '/yorokobu_gacha_db.json');
    $pool = isset($db['rec'][$r]['tiers'][$t]) && is_array($db['rec'][$r]['tiers'][$t]) ? $db['rec'][$r]['tiers'][$t] : array();
    $x = isset($_GET['x']) && is_string($_GET['x']) ? $_GET['x'] : '';
    $cand = array();
    foreach ($pool as $row) { if (!($x !== '' && count($pool) > 1 && isset($row[3]) && $row[3] === $x)) { $cand[] = $row; } }
    out(200, array('row' => count($cand) ? $cand[random_int(0, count($cand) - 1)] : null));
}
if (isset($_GET['g'])) {
    $g = $_GET['g'];
    if (!slug($g)) { out(400); }
    $db = load_db($priv . '/yorokobu_rec_db.json');
    $min = yen_or_null($_GET['min'] ?? null); $max = yen_or_null($_GET['max'] ?? null);
    $gender = isset($_GET['gender']) && is_string($_GET['gender']) && strlen($_GET['gender']) <= 8 ? $_GET['gender'] : '';
    $n = max(1, min(12, (int)($_GET['n'] ?? 4)));
    $items = array();
    foreach ((isset($db[$g]) && is_array($db[$g]) ? $db[$g] : array()) as $it) {
        if ($gender !== '' && !empty($it['g']) && $it['g'] !== $gender) { continue; }
        if ($max !== null && $it['p'] > $max) { continue; }
        if ($min !== null && $it['p'] < $min) { continue; }
        $items[] = $it;
        if (count($items) >= $n) { break; }
    }
    out(200, array('items' => $items));
}
out(400);
